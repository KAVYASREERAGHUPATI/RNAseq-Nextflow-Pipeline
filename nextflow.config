

nextflow.enable.dsl = 2


//** Pipeline parameters**

params {
    input     = 'example_samplesheet.csv'
    outdir    = 'results'
    reference = 'reference/genome.fa'
    gtf       = 'reference/genes.gtf'
}

// Docker configuration

docker.enabled = true


//** Process configuration**

process {

    executor = 'local'

    // Default resources
    cpus = 2
    memory = '4 GB'

    // Raw FastQC
    withName: FASTQC {
        cpus = 4
        memory = '8 GB'
    }

    // Adapter and quality trimming
    withName: TRIMMOMATIC {
        cpus = 4
        memory = '8 GB'
    }

    // Post-trimming FastQC
    withName: FASTQC_TRIMMED {
        cpus = 4
        memory = '8 GB'
    }

    // STAR genome indexing
    withName: STAR_INDEX {
        cpus = 8
        memory = '64 GB'
    }

    // STAR alignment
    withName: STAR_ALIGN {
        cpus = 8
        memory = '32 GB'
    }

    // Gene-level quantification
    withName: FEATURECOUNTS {
        cpus = 4
        memory = '8 GB'
    }

    // Merge count matrices
    withName: MERGE_COUNTS {
        cpus = 1
        memory = '4 GB'
    }

    // MultiQC reports
    withName: /MULTIQC_RAW|MULTIQC_TRIMMED|MULTIQC_ALIGNMENT/ {
        cpus = 2
        memory = '4 GB'
    }
}


//** Execution reports**

report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/nextflow_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/nextflow_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/nextflow_dag.html"
    overwrite = true
}
